# External layers fetched by kas at build/CI time (not vendored, not committed).
# meta-agl, meta-agl-demo, meta-agl-devel (repo root) ARE vendored and tracked separately.
/external/
/bsp/

# kas / bitbake build output
/build/
/.bbsetup-*.conf.json
/tmp/
/sstate-cache/
/downloads/
/.config.yaml

# Python
__pycache__/
*.pyc

# Local working notes, not part of the tracked project history.
/WIP.md
# .claude/ itself stays ignored (session notes, local settings) EXCEPT skills/, which is
# committed so Claude Code skills (e.g. kas-operations) travel with the repo for every
# teammate instead of staying stuck on one local checkout.
.claude/*
!.claude/skills/
/.presentation/
.kas_shell_history
